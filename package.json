{
  "name": "export-contract-generator",
  "version": "1.0.0",
  "description": "Web-based Export Contract Generator for automating commercial contract creation and management",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "set NODE_OPTIONS=--max_old_space_size=4096 && npm start --prefix client",
    "install-all": "npm install && npm install --prefix client",
    "build": "set NODE_OPTIONS=--max_old_space_size=4096 && npm run build --prefix client",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:services": "jest server/services",
    "test:controllers": "jest server/controllers",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov --coverageReporters=html",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headed": "cypress run --headed",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:spec": "cypress run --spec"
  },
  "keywords": [
    "export",
    "contract",
    "generator",
    "commercial",
    "document"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "cypress": "^15.11.0",
    "date-fns": "^3.0.6",
    "docxtemplater": "^3.42.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "multer": "^2.1.0",
    "number-to-words": "^1.2.4",
    "pdfkit": "^0.14.0",
    "pizzip": "^3.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.2",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^3.0.2"
  }
}
